    "@t3tools/source-control-core": "workspace:*",
    "@t3tools/source-control-github": "workspace:*",
    "effect": "catalog:",
    "jose": "catalog:",
    "node-pty": "^1.2.0-beta.15",
    "playwright-core": "1.60.0",
    "proper-lockfile": "4.1.2",
    "stream-chain": "^4.2.5",
