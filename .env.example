# Optional settings for local Cogenly builds. Copy to `.env` to use them.
# Cloud features (sign-in, remote relay) are off unless these are set.
# Do not commit secrets.

# COGENLY_CLERK_PUBLISHABLE_KEY=
# COGENLY_CLERK_JWT_TEMPLATE=
# COGENLY_CLERK_CLI_OAUTH_CLIENT_ID=
# COGENLY_RELAY_URL=
# COGENLY_HOSTED_APP_URL=
